# Copy this file to backend/.env on the live server and fill in real values.
# Never commit the real .env file.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# 0 on the live server, 1 on your laptop
DJANGO_DEBUG=0

# Your site's address without https:// (comma-separated if several)
DJANGO_ALLOWED_HOSTS=yourname.pythonanywhere.com

# Same address WITH https:// (needed for the /admin/ login form)
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com

# Optional: other websites allowed to call the API (the Android app is already allowed)
DJANGO_CORS_ORIGINS=
